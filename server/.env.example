# MultiDeck Server - Configuration optionnelle

# Port d'écoute du serveur backend (défaut : 3001)
PORT=3001

# Clé API Google / YouTube Data v3 (Optionnelle, pour la recherche publique sans cookies)
YOUTUBE_API_KEY=

# --- Accès distant (désactivé par défaut : seul ce PC peut utiliser MultiDeck) ---
# Autoriser les connexions venant d'autres machines (Tailscale, réseau local...)
# MULTIDECK_ALLOW_REMOTE=true
# Noms d'hôte / IP utilisés pour ouvrir MultiDeck à distance, séparés par des virgules
# (ex : monpc.tailnet.ts.net,100.101.102.103 ou deck.mondomaine.fr pour un Cloudflare Tunnel)
# MULTIDECK_ALLOWED_HOSTS=
